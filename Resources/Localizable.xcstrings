    "Detiene el proceso. Lo ya verificado queda registrado y no se borra nada más.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops the process. Everything already verified stays logged and nothing else is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el proceso. Lo ya verificado queda registrado y no se borra nada más."
          }
        }
      }
    },
    "Disco externo válido.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid external drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco externo válido."
          }
        }
      }
    },
    "El acceso a Fotos es limitado. Concede acceso completo para procesar toda la fototeca.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos access is limited. Grant full access to process the whole library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Fotos es limitado. Concede acceso completo para procesar toda la fototeca."
          }
        }
      }
    },
    "El archivo es demasiado grande para el formato del disco (FAT32 admite como máximo 4 GB). Usa un disco APFS o exFAT.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large for the drive's format (FAT32 allows at most 4 GB). Use an APFS or exFAT drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es demasiado grande para el formato del disco (FAT32 admite como máximo 4 GB). Usa un disco APFS o exFAT."
          }
        }
      }
    },
    "El disco destino ya no está disponible (¿se desconectó?). Se detiene la copia; no se borra nada pendiente.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination drive is no longer available (was it disconnected?). Copying stops; nothing pending is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco destino ya no está disponible (¿se desconectó?). Se detiene la copia; no se borra nada pendiente."
          }
        }
      }
    },
    "El disco es de solo lectura.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is read-only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco es de solo lectura."
          }
        }
      }
    },
    "El disco externo es de solo lectura.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The external drive is read-only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
