    "Fotos no encuentra el archivo original de este elemento o está dañado. Ábrelo en Fotos para comprobarlo. No se borró nada.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos can't find this item's original file, or it is damaged. Open it in Photos to check. Nothing was deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos no encuentra el archivo original de este elemento o está dañado. Ábrelo en Fotos para comprobarlo. No se borró nada."
          }
        }
      }
    },
    "Fotos no permite borrar este elemento (por ejemplo, si pertenece a un álbum compartido).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos doesn't allow deleting this item (for example, if it belongs to a shared album)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos no permite borrar este elemento (por ejemplo, si pertenece a un álbum compartido)."
          }
