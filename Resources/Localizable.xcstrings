    "No se pudo usar la clave del Llavero para firmar el registro de copias. Se puede copiar, pero antes de borrar algo de iCloud se comprobará su copia contra el original.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keychain key for signing the copy log couldn't be used. Copying works, but before anything is deleted from iCloud its copy will be checked against the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo usar la clave del Llavero para firmar el registro de copias. Se puede copiar, pero antes de borrar algo de iCloud se comprobará su copia contra el original."
          }
        }
      }
    },
    "Ocultar detalles técnicos": {
