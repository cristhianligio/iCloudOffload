    "Abre la carpeta de destino en Finder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the destination folder in Finder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la carpeta de destino en Finder"
          }
        }
      }
    },
    "Abre la carpeta oculta .icloud-offload y selecciona manifest.jsonl": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the hidden .icloud-offload folder and selects manifest.jsonl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la carpeta oculta .icloud-offload y selecciona manifest.jsonl"
