    "No hay espacio suficiente en el disco interno del Mac para que Fotos descargue este archivo de iCloud. Libera espacio y vuelve a intentarlo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough space on the Mac's internal disk for Photos to download this file from iCloud. Free up space and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente en el disco interno del Mac para que Fotos descargue este archivo de iCloud. Libera espacio y vuelve a intentarlo."
          }
        }
      }
    },
    "No hay permiso para escribir en la carpeta de destino.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no permission to write to the destination folder."
