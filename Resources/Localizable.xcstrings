    "No se pudo descargar el archivo desde iCloud por un problema con la conexión a internet. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file couldn't be downloaded from iCloud because of an internet connection problem. %@"
