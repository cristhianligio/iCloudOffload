{
  "sourceLanguage": "es",
  "strings": {
    " Se detiene la copia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Copying stops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Se detiene la copia."
          }
        }
      }
    },
    "%@ copiados": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copied"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copiados"
          }
        }
      }
    },
    "%@ de %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ de %2$@"
          }
        }
      }
    },
    "%@ · %@, %@ · copia anterior confirmada contra iCloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@, %@ · previous copy confirmed against iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@, %3$@ · copia anterior confirmada contra iCloud"
          }
        }
      }
    },
    "%@ · %@, %@ · copiado y verificado": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@, %@ · copied and verified"
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@, %3$@ · copiado y verificado"
          }
        }
      }
    },
    "%@, %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@: detenido antes de terminar. No se borró de iCloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: stopped before finishing. Not deleted from iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: detenido antes de terminar. No se borró de iCloud."
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld archivos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos"
          }
        }
      }
    },
    "%lld copia(s) anterior(es) no tienen una firma válida en el registro (p. ej. hechas con una versión anterior de la app). Antes de borrarlas de iCloud se compararán con el original.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld previous copies have no valid signature in the log (e.g. made with an earlier version of the app). They will be compared with the original before being deleted from iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld copia(s) anterior(es) no tienen una firma válida en el registro (p. ej. hechas con una versión anterior de la app). Antes de borrarlas de iCloud se compararán con el original."
          }
        }
      }
    },
    "%lld de %lld elementos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld items"
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld de %2$lld elementos"
          }
        }
      }
    },
    "%lld elementos encontrados · %lld por copiar · %lld ya copiados antes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items found · %lld to copy · %lld already copied before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld elementos encontrados · %2$lld por copiar · %3$lld ya copiados antes."
          }
        }
      }
    },
    "%lld elementos registrados · %lld borrados de iCloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items logged · %lld deleted from iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld elementos registrados · %2$lld borrados de iCloud"
          }
        }
      }
    },
