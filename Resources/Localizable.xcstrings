    "Actividad": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad"
          }
        }
      }
    },
    "Al volver a ejecutar la app con el mismo disco, se usa para saltar lo ya copiado y para re-verificar los archivos antes de borrar nada de iCloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you run the app again with the same drive, it is used to skip what was already copied and to re-verify the files before deleting anything from iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al volver a ejecutar la app con el mismo disco, se usa para saltar lo ya copiado y para re-verificar los archivos antes de borrar nada de iCloud."
          }
        }
      }
    },
    "Aquí verás cada archivo copiado, verificado y borrado.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each copied, verified and deleted file will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí verás cada archivo copiado, verificado y borrado."
          }
        }
      }
    },
    "Aún no hay registro en este disco": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No log on this drive yet"
