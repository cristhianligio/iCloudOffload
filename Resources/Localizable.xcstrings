      }
    },
    "FAT32 no admite archivos de más de 4 GB: los videos largos fallarán. Usa APFS o exFAT.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FAT32 doesn't support files larger than 4 GB: long videos will fail. Use APFS or exFAT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FAT32 no admite archivos de más de 4 GB: los videos largos fallarán. Usa APFS o exFAT."
