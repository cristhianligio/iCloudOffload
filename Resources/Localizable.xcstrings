    "No se borró el lote: %@ El borrado queda desactivado en esta ejecución; la copia continúa.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The batch wasn't deleted: %@ Deletion is turned off for this run; copying continues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se borró el lote: %@ El borrado queda desactivado en esta ejecución; la copia continúa."
          }
        }
      }
    },
    "No se borró nada; se volverá a intentar en la próxima ejecución.": {
      "localizations": {
